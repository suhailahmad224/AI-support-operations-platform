# ==============================================================================
# AI Support & Operations Platform - Environment Configuration Example
# Copy this file to backend/.env and adjust values for your local environment.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Configuration
# Connects to standalone MongoDB if available; in development mode, automatically 
# falls back to an embedded in-memory MongoDB instance if mongod is unreachable.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_support_platform

# Authentication & Security
# In production, JWT_SECRET must be at least 32 characters long.
JWT_SECRET=your_secure_jwt_secret_key_at_least_32_characters_here
JWT_EXPIRES_IN=7d

# AI Intelligence & Knowledge Base (Mock AI active by default - no external key needed)
# Supported options: mock | gemini | groq
AI_PROVIDER=mock
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Email & Outbound Notification Alerts (Optional)
EMAIL_ENABLED=false
EMAIL_FROM=support@aiplatform.local
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
